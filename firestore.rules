rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['lgu_admin', 'admin'];
    }

    function ownsReport() {
      return signedIn() && resource.data.createdBy == request.auth.uid;
    }

    match /users/{userId} {
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.role == 'citizen'
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.keys().hasAll([
          'uid',
          'fullName',
          'email',
          'role',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'uid',
          'fullName',
          'email',
          'phoneNumber',
          'address',
          'photoURL',
          'role',
          'createdAt',
          'updatedAt'
        ]);

      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());

      allow update: if isAdmin() || (
        signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'fullName',
          'email',
          'phoneNumber',
          'address',
          'photoURL',
          'updatedAt'
        ])
      );

      allow delete: if false;
    }

    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid;

      allow read: if ownsReport() || isAdmin();

      allow update: if isAdmin() || (
        ownsReport()
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'description',
          'photoUrl',
          'imageUrl',
          'evidenceImage',
          'photoPreview',
          'updatedAt'
        ])
      );

      allow delete: if false;
    }

    match /publicReports/{reportId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['supportCount', 'updatedAt'])
        && request.resource.data.supportCount == resource.data.supportCount + 1
        && getAfter(/databases/$(database)/documents/publicReports/$(reportId)/supporters/$(request.auth.uid)).data.uid == request.auth.uid;
    }

    match /publicReports/{reportId}/supporters/{supporterId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.auth.uid == supporterId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'supportedAt'])
        && !exists(/databases/$(database)/documents/publicReports/$(reportId)/supporters/$(supporterId));
      allow update, delete: if false;
    }

    match /adminLogs/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
