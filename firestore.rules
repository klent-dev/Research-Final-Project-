rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Research/demo mode:
    // Citizen and Admin auth are intentionally bypassed while testing.
    // Keep deletes blocked so records remain traceable.
    match /reports/{reportId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if false;
    }

    match /users/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    match /{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
